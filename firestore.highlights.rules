rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: scan_quota
    // Document ID: Firebase Auth UID
    // Fields:
    //   - day: string (required, exactly YYYY-MM-DD) - local day key
    //   - count: int (required, 1..10000) - scans recorded that day
    //   - updatedAt: timestamp (required) - last write time
    //   - maxOverride: int (optional, 0..10000) - 0 means unused; admin sets >= 1
    //
    // Ownership is the document ID. There is no uid/role field.
    // Clients may seed maxOverride=0. Clients cannot raise it.
    // Console / Admin SDK can set maxOverride >= 1.
    // Leftover bonus / bonusDay keys may be deleted by the client.
    // Collection: settings
    // Document ID: scan_limits
    // Fields:
    //   - maxScansPerDay: int (0..10000) - global daily cap
    // Clients may read. Writes are Console / Admin SDK only.
    //
    // Daily max is enforced in the app from settings/scan_limits.
    //
    // Collection: saved_highlights/{userId}/items/{itemId}
    // Fields:
    //   - text, literal, contextual, color: string
    //   - meaningLanguageId: string
    //   - savedAt: timestamp
    //   - scanId: string (optional) - groups highlights from one scan
    // Ownership is the userId path segment. Clients may CRUD their own items.
    //
    // Collection: highlight_transfers/{transferId}
    // Document ID: exporter Auth uid. One transfer per user; later shares update it.
    // Fields:
    //   - createdBy: string (auth uid of the exporter; immutable after create)
    //   - createdAt, expiresAt: timestamp (app TTL is 30 minutes; rules allow 35m for clock skew)
    //   - itemCount: int (1..200)
    //   - itemIds: list of item document ids (same length as itemCount)
    // Subcollection: items/{itemId} uses the saved-highlight schema.
    // Owner is the path uid. Expiry lives only on the parent document.
    // Item list is owner-only so rules do not get() the parent per item.
    // Importers get the parent (expiry check) then get items by itemIds.
    // Get by transferId only. Do not list the transfers collection.
    // Owner get is allowed by path uid even when the document is missing.
    //
    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isRecentTimestamp(time) {
      return time is timestamp &&
        time <= request.time + duration.value(1, 'm') &&
        time >= request.time - duration.value(5, 'm');
    }

    function isValidDayKey(value) {
      return value is string &&
        value.size() == 10 &&
        value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidOptionalMaxOverride(data) {
      return !('maxOverride' in data) ||
        (data.maxOverride is int &&
          data.maxOverride >= 0 &&
          data.maxOverride <= 10000);
    }

    function hasNoAdminFields(data) {
      return !('maxOverride' in data);
    }

    function isAdminPlaceholder(data) {
      return data.maxOverride == 0;
    }

    function adminFieldUnchangedOrSeeded(field, defaultValue) {
      return !(field in request.resource.data) ||
        ((field in resource.data) &&
          request.resource.data[field] == resource.data[field]) ||
        (!(field in resource.data) &&
          request.resource.data[field] == defaultValue);
    }

    function adminFieldsUnchangedOrSeeded() {
      return adminFieldUnchangedOrSeeded('maxOverride', 0);
    }

    function isCountUnchanged() {
      return request.resource.data.day == resource.data.day &&
        request.resource.data.count == resource.data.count;
    }

    function isValidQuota(data) {
      return hasRequiredFields(['day', 'count', 'updatedAt']) &&
        hasOnlyAllowedFields([
          'day',
          'count',
          'updatedAt',
          'maxOverride'
        ]) &&
        isValidDayKey(data.day) &&
        data.count is int &&
        data.count >= 1 &&
        data.count <= 10000 &&
        isRecentTimestamp(data.updatedAt) &&
        isValidOptionalMaxOverride(data) &&
        uidUnchanged();
    }

    function isValidQuotaCreate() {
      return isValidQuota(request.resource.data) &&
        request.resource.data.count == 1 &&
        (hasNoAdminFields(request.resource.data) ||
          isAdminPlaceholder(request.resource.data));
    }

    function isValidQuotaUpdate() {
      return isValidQuota(request.resource.data) &&
        uidNotModified() &&
        adminFieldsUnchangedOrSeeded() &&
        // bonus / bonusDay may appear only so leftover keys can be deleted.
        request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['day', 'count', 'updatedAt', 'maxOverride', 'bonus', 'bonusDay']) &&
        (
          (request.resource.data.day != resource.data.day &&
            request.resource.data.count == 1) ||
          (request.resource.data.day == resource.data.day &&
            request.resource.data.count == resource.data.count + 1) ||
          isCountUnchanged()
        );
    }

    match /scan_quota/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidQuotaCreate();
      allow update: if isOwner(userId) && isValidQuotaUpdate();
      allow delete: if false;
    }

    match /settings/{documentId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }

    function isNonEmptyString(value, maxSize) {
      return value is string &&
        value.size() > 0 &&
        value.size() <= maxSize;
    }

    function isValidOptionalScanId(data) {
      return !('scanId' in data) ||
        (data.scanId is string &&
          data.scanId.size() > 0 &&
          data.scanId.size() <= 64);
    }

    function isValidSavedHighlight(data) {
      return hasRequiredFields([
          'text',
          'literal',
          'contextual',
          'color',
          'meaningLanguageId',
          'savedAt'
        ]) &&
        hasOnlyAllowedFields([
          'text',
          'literal',
          'contextual',
          'color',
          'meaningLanguageId',
          'savedAt',
          'scanId'
        ]) &&
        isNonEmptyString(data.text, 5000) &&
        data.literal is string &&
        data.literal.size() <= 5000 &&
        data.contextual is string &&
        data.contextual.size() <= 5000 &&
        isNonEmptyString(data.color, 32) &&
        isNonEmptyString(data.meaningLanguageId, 16) &&
        data.savedAt is timestamp &&
        isValidOptionalScanId(data);
    }

    match /saved_highlights/{userId}/items/{itemId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) &&
        isValidSavedHighlight(request.resource.data);
      allow update: if isOwner(userId) &&
        isValidSavedHighlight(request.resource.data);
      allow delete: if isOwner(userId);
    }

    function isValidTransferWrite() {
      return isAuthenticated() &&
        hasRequiredFields([
          'createdBy',
          'createdAt',
          'expiresAt',
          'itemCount',
          'itemIds'
        ]) &&
        hasOnlyAllowedFields([
          'createdBy',
          'createdAt',
          'expiresAt',
          'itemCount',
          'itemIds'
        ]) &&
        request.resource.data.createdBy is string &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.expiresAt > request.time &&
        request.resource.data.expiresAt <= request.time + duration.value(35, 'm') &&
        request.resource.data.itemCount is int &&
        request.resource.data.itemCount >= 1 &&
        request.resource.data.itemCount <= 200 &&
        request.resource.data.itemIds is list &&
        request.resource.data.itemIds.size() == request.resource.data.itemCount;
    }

    function isValidTransferCreate() {
      return isValidTransferWrite() &&
        request.resource.data.createdBy == request.auth.uid;
    }

    function isValidTransferUpdate() {
      return isValidTransferWrite() &&
        resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdBy == resource.data.createdBy;
    }

    function transferIsUnexpired() {
      return resource != null &&
        resource.data.expiresAt is timestamp &&
        resource.data.expiresAt > request.time;
    }

    function transferParentUnexpired(transferId) {
      return exists(/databases/$(database)/documents/highlight_transfers/$(transferId)) &&
        get(/databases/$(database)/documents/highlight_transfers/$(transferId))
          .data.expiresAt is timestamp &&
        get(/databases/$(database)/documents/highlight_transfers/$(transferId))
          .data.expiresAt > request.time;
    }

    match /highlight_transfers/{transferId} {
      allow get: if isAuthenticated() &&
        (request.auth.uid == transferId || transferIsUnexpired());
      allow list: if false;
      allow create: if request.auth.uid == transferId && isValidTransferCreate();
      allow update: if isValidTransferUpdate();
      allow delete: if false;

      match /items/{itemId} {
        allow list: if isAuthenticated() && request.auth.uid == transferId;
        allow get: if isAuthenticated() &&
          (request.auth.uid == transferId || transferParentUnexpired(transferId));
        allow create, update: if isAuthenticated() &&
          request.auth.uid == transferId &&
          isValidSavedHighlight(request.resource.data);
        allow delete: if isAuthenticated() && request.auth.uid == transferId;
      }
    }
  }
}
